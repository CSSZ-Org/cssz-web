; background-size: cover; display: inline;">             <source srcset='/images/events/2022-10-15-hike-uetliberg-thalwil/everyone_hu_60cb807348e3a743.webp 267w, /images/events/2022-10-15-hike-uetliberg-thalwil/everyone_hu_f4b41f6f78a41103.webp 534w'                     sizes="(max-width: 267px) 100vw, 267px"                     type="image/webp"             /><source srcset='/images/events/2022-10-15-hike-uetliberg-thalwil/everyone_hu_e2da240d71c36b6e.jpeg 267w, /images/events/2022-10-15-hike-uetliberg-thalwil/everyone_hu_c8263d6f7aa62e52.jpeg 534w'                     sizes="(max-width: 267px) 100vw, 267px"                     type="image/jpeg"             /><img src="/images/events/2022-10-15-hike-uetliberg-thalwil/everyone_hu_e2da240d71c36b6e.jpeg"                  width="267"                  height="200"                                                                                     /></picture> <picture class="img" style="background: url(data:image/jpeg;base64,&#43;gEAAwEBAQEBAQEBAQAAAAAAAAECAwQFBgcICQoLEQACAQIEBAMEBwUEBAABAncAAQIDEQQFITEGEkFRB2FxEyIygQgUQpGhscEJIzNS8BVictEKFiQ04SXxFxgZGiYnKCkqNTY3ODk6Q0RFRkdISUpTVFVWV1hZWmNkZWZnaGlqc3R1dnd4eXqCg4SFhoeIiYqSk5SVlpeYmZqio6Slpqeoqaqys7S1tre4ubrCw8TFxsfIycrS09TV1tfY2dri4&#43;Tl5ufo6ery8/T19vf4&#43;fr/2gAMAwEAAhEDEQA/AI/BfieVLC4e5jkmcMoLeaR0XHAA/nXRv44nRcRRzbBztaTBNeX6lM1pbI0M8tmrPhkix82ep&#43;tZtyGWBzFf3zSYyAZMZ/KoVeVjV4fXc7zWfiNeRXirCFiXYDjrk5PPNZ//AAsrUf8Anov/AHyK5y3jt2hDMu9jyzOuSTUvk23/ADyj/wC&#43;BUOvItYc/9k=); background-size: cover; display: inline;">             <source srcset='/images/events/2022-10-15-hike-uetliberg-thalwil/view_hu_737b57bd427a2503.webp 267w, /images/events/2022-10-15-hike-uetliberg-thalwil/view_hu_c82b425fd0e36944.webp 534w'                     sizes="(max-width: 267px) 100vw, 267px"                     type="image/webp"             /><source srcset='/images/events/2022-10-15-hike-uetliberg-thalwil/view_hu_74984bd0ae786cac.jpeg 267w, /images/events/2022-10-15-hike-uetliberg-thalwil/view_hu_f002958d12d67438.jpeg 534w'                     sizes="(max-width: 267px) 100vw, 267px"                     type="image/jpeg"             /><img src="/images/events/2022-10-15-hike-uetliberg-thalwil/view_hu_74984bd0ae786cac.jpeg"                  width="267"                  height="200"                                                                                     /></picture> <picture class="img" style="background: url(data:image/jpeg;base64,&#43;gEAAwEBAQEBAQEBAQAAAAAAAAECAwQFBgcICQoLEQACAQIEBAMEBwUEBAABAncAAQIDEQQFITEGEkFRB2FxEyIygQgUQpGhscEJIzNS8BVictEKFiQ04SXxFxgZGiYnKCkqNTY3ODk6Q0RFRkdISUpTVFVWV1hZWmNkZWZnaGlqc3R1dnd4eXqCg4SFhoeIiYqSk5SVlpeYmZqio6Slpqeoqaqys7S1tre4ubrCw8TFxsfIycrS09TV1tfY2dri4&#43;Tl5ufo6ery8/T19vf4&#43;fr/2gAMAwEAAhEDEQA/ALd/dI2qSray7o0JVXViQRznOfbg0ulGJ9ahguJJPJncAiHllODxjuDxx7VzfifVrK18Q3E9qmFaMMdpOwserLnp9KNP1PfPaXEpYw&#43;YgY46BiBycHHX9KluSegz1m7uUtpvKt7h4IQo2omz06nPfOag/tF/&#43;ghP/wCQ65bWNUsbXUXgslkkhQAAoWIz36D15/Gs/wDtxP8AnhP/AORP8KvmDQ4zxpI1zcWclxJ/pEsC7sRtHwpIwAenp68fSptO1J7Tw7NZO7CcbmEYj642lWY&#43;23GMetcc11PdtBJcStI&#43;Cu5uuB0FWIiUV9pwTH1H1qRXPWdR8YWsFwr2upWoWdBM4eIbgzdjk&#43;mKqf8ACc/9ROy/79LXmjAPI&#43;4ZwxA9hSeWn90VDkFz/9k=); background-size: cover; display: inline;">             <source srcset='/images/events/2022-10-15-hike-uetliberg-thalwil/spider_hu_c0c2885b7f9ee035.webp 150w, /images/events/2022-10-15-hike-uetliberg-thalwil/spider_hu_fb6fad70cd4cacf5.webp 300w'                     sizes="(max-width: 150px) 100vw, 150px"                     type="image/webp"             /><source srcset='/images/events/2022-10-15-hike-uetliberg-thalwil/spider_hu_795f4a12e281ac07.jpeg 150w, /images/events/2022-10-15-hike-uetliberg-thalwil/spider_hu_3c318395a99cf58d.jpeg 300w'                     sizes="(max-width: 150px) 100vw, 150px"                     type="image/jpeg"             /><img src="/images/events/2022-10-15-hike-uetliberg-thalwil/spider_hu_795f4a12e281ac07.jpeg"                  width="150"                  height="200"                                                                                     /></picture> <p><a class="link" href="https://photos.app.goo.gl/5VGVbvPTzKh7zBF26" target="_blank" rel="noopener">See more photos from the trip here!</a></p> <hr> <p>CSSZ invites you and your friends to join the first CSSZ trip of the Autumn Semester 2022.</p> <p>We&rsquo;ll meet at the tram stop <em>Triemli</em> at 9:30 a.m. and start our trip in the direction to Uetliberg, continuing to Thalwil. There we&rsquo;ll take the <em>Ship 3731 29</em> to get back to <em>Zürich Bürkliplatz (See)</em>. Expected duration of this hike with T1 level is 5:30 h.</p> <p><strong>Total distance:</strong> 19 km  <strong>Expected duration:</strong> 5:30 h  <strong>Uphill/downhill:</strong> 570 m</p>
